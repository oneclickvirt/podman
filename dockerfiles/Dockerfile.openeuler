FROM openeuler/openeuler:22.03

# Native GitHub runner probes verified Huawei, NJU and TUNA throughput.
# DNF can fall back across HTTPS mirrors, and still verifies every RPM using
# the original upstream signing key. Do not ignore update/install failures.
COPY configure_openeuler_repositories.py /tmp/configure_openeuler_repositories.py
RUN python3 /tmp/configure_openeuler_repositories.py /etc/yum.repos.d/openEuler.repo && \
    rm /tmp/configure_openeuler_repositories.py && \
    timeout --kill-after=30s 45m dnf --setopt=timeout=30 --setopt=retries=3 --setopt=minrate=65536 --setopt=max_parallel_downloads=10 update -y && \
    timeout --kill-after=30s 45m dnf --setopt=timeout=30 --setopt=retries=3 --setopt=minrate=65536 --setopt=max_parallel_downloads=10 install -y \
        openssh-server \
        sudo \
        curl \
        wget \
        cronie \
        ca-certificates \
        iproute \
        iputils \
        net-tools \
        vim \
        procps-ng \
        tzdata \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# 生成 SSH 主机密钥
RUN ssh-keygen -A

# 配置 sshd
RUN sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?UsePAM.*/UsePAM yes/' /etc/ssh/sshd_config && \
    mkdir -p /var/run/sshd

# 禁用 SELinux（容器内）
RUN if [ -f /etc/selinux/config ]; then \
        sed -i 's/^SELINUX=.*/SELINUX=disabled/' /etc/selinux/config; \
    fi

# 设置时区
RUN ln -sf /usr/share/zoneinfo/UTC /etc/localtime && \
    echo "UTC" > /etc/timezone

# 更新 motd
RUN echo 'Related repo https://github.com/oneclickvirt/podman' >> /etc/motd && \
    echo '--by https://t.me/spiritlhl' >> /etc/motd

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22

ENTRYPOINT ["/entrypoint.sh"]
